<mxfile host="drawio"><diagram name="model_structure" id="model_structure"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="driver_position_cmd&lt;br&gt;позиция контроллера u" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="260" height="50" as="geometry"/></mxCell><mxCell id="c2" value="front_bogie_velocity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="210" height="50" as="geometry"/></mxCell><mxCell id="c3" value="rear_bogie_velocity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="610" y="20" width="210" height="50" as="geometry"/></mxCell><mxCell id="c4" value="GNSS master / rover&lt;br&gt;&lt;i&gt;первые ~2 с&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="20" width="230" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Модель привода&lt;/b&gt;&lt;br&gt;a(u, v): тяга a_T(u, v), торможение a_B(u, v), выбег a₀(v);&lt;br&gt;задержка τ_d, инерционное звено T_a;&lt;br&gt;уклон −k_i·i(s), кривые −k_κ·|κ(s)|;&lt;br&gt;|a| ≤ μ·g; поправка эхо-сети" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="260" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Предобработка&lt;/b&gt;&lt;br&gt;км/ч → м/с (×1/3,5988), выбросы, залипание; шум R — по разности тележек" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="440" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Выставка&lt;/b&gt;&lt;br&gt;base_link = master + 0,794·(rover − master);&lt;br&gt;курс master → rover" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="230" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Фильтр Калмана [v, b] + отбраковка проскальзывания&lt;/b&gt;&lt;br&gt;гейт невязки, огибающая ускорения колеса, расхождение тележек, откат начала эпизода, гистерезис; ZUPT на стоянке" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="214" width="440" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;v̂&lt;/b&gt; — продольная скорость,&lt;br&gt;â — ускорение" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="210" height="50" as="geometry"/></mxCell><mxCell id="c10" value="флаг и вид проскальзывания,&lt;br&gt;λ, |a|/g" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="340" width="210" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Карта пути (pathgraph)&lt;/b&gt;&lt;br&gt;s → x, y, z, курс; ветка на стрелке — по профилю скорости; коррекция s на местах остановок" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="750" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Положение&lt;/b&gt; — точка base_link в плоских MGRS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="552" width="330" height="44" as="geometry"/></mxCell><mxCell id="c13" value="В ноде tram_odometry сверх этой схемы — коррекция положения по редким точкам GNSS в пути (параметр gnss_correction)" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;spacing=6;fillColor=#fff9e6;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="780" y="540" width="350" height="60" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="z_f, z_r" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;