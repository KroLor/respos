<mxfile host="drawio"><diagram name="architecture" id="architecture"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="/vehicle/&lt;br&gt;front_bogie_velocity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="200" height="76" as="geometry"/></mxCell><mxCell id="c2" value="/vehicle/&lt;br&gt;rear_bogie_velocity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="235" y="12" width="200" height="76" as="geometry"/></mxCell><mxCell id="c3" value="/vehicle/&lt;br&gt;driver_position_cmd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="450" y="12" width="200" height="76" as="geometry"/></mxCell><mxCell id="c4" value='/sensing/gnss/&lt;br&gt;{master,rover}/fix&lt;br&gt;&lt;font face="Helvetica"&gt;&lt;i&gt;выставка в первые секунды,&lt;br&gt;коррекция в пути&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="665" y="12" width="215" height="76" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Предобработка входов&lt;/b&gt;&lt;br&gt;метки времени, значения, пропуски; счётчики принятого и отброшенного — в /diagnostics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="860" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Надзор (supervisor)&lt;/b&gt;&lt;br&gt;основной оценщик; при исключении или нефизичном результате — запасной, положение продолжается от последней точки модели" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="216" width="860" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;wheel_baseline&lt;/b&gt; — запасной&lt;br&gt;работает параллельно: скорость по тележкам" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="312" width="300" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;backup_model&lt;/b&gt; — основной&lt;br&gt;модель tram_backup_odometry: фильтр Калмана по скоростям тележек, модель привода и эхо-сеть, отбраковка проскальзывания; положение base_link в плоских MGRS по карте пути, коррекция на остановках и по редким точкам GNSS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="312" width="540" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Публикация&lt;/b&gt;&lt;br&gt;на каждое сообщение контроллера (~20 Гц); header.stamp = метка входного сообщения; положение — только после выставки или относительная одометрия без GNSS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="472" width="860" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Выходные топики&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fontSize=12;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf7fc;" vertex="1" parent="1"><mxGeometry x="20" y="576" width="860" height="120" as="geometry"/></mxCell><mxCell id="c11" value="/result/velocity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="c10"><mxGeometry x="20" y="38" width="260" height="32" as="geometry"/></mxCell><mxCell id="c12" value="/result/position" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="c10"><mxGeometry x="300" y="38" width="260" height="32" as="geometry"/></mxCell><mxCell id="c13" value="/result/acceleration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="c10"><mxGeometry x="580" y="38" width="260" height="32" as="geometry"/></mxCell><mxCell id="c14" value="/result/slip_detected" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="c10"><mxGeometry x="20" y="80" width="260" height="32" as="geometry"/></mxCell><mxCell id="c15" value="/result/slip_ratio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="c10"><mxGeometry x="300" y="80" width="260" height="32" as="geometry"/></mxCell><mxCell id="c16" value="/diagnostics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="c10"><mxGeometry x="580" y="80" width="260" height="32" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=